#include <winuser.h>
#include <winver.h>

1 ICON "@DX_ROOT@/brand/icon/appicon.ico"
1 RT_MANIFEST "@DX_ROOT@/res/app.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "080404b0"
    BEGIN
      VALUE "CompanyName", "Deixion"
      VALUE "FileDescription", "Deixion"
      VALUE "FileVersion", "@PROJECT_VERSION@"
      VALUE "InternalName", "@DX_INTERNAL@"
      VALUE "OriginalFilename", "@DX_ORIGINAL@"
      VALUE "ProductName", "Deixion"
      VALUE "ProductVersion", "@PROJECT_VERSION@"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x804, 1200
  END
END
